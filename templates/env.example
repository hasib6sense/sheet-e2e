# Google Sheets (required for runner sheet sync + project Google Sheets MCP)
# Same ID is loaded by .cursor/mcp.json via envFile when using project-local MCP.
GOOGLE_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=credentials/credentials.json

# Playwright / runner
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# → Runner UI: http://localhost:3000/e2e-runner (see e2e/README.md)
# PLAYWRIGHT_WEB_SERVER=npm run start
# TEST_SIGNIN_EMAIL=
# TEST_SIGNIN_PASSWORD=
# E2E_RUNNER_ENABLED=1

# Optional overrides
# E2E_RESULTS_FILE=playwright-results.json
# E2E_SKIP_TABS=Summery
# E2E_TAB_SUITES_PATH=e2e/tab-suites.json
# E2E_NO_SHEET_SYNC=1
# E2E_TABS="Sign In,Projects"
# SHEET_E2E_CONFIG=e2e/sheet-e2e.config.json
# E2E_UNIT_RESULTS_FILE=jest-results.json
