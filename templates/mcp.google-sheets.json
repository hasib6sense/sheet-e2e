{
  "mcpServers": {
    "google-sheets": {
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@6sense/sheet-e2e/bin/google-sheets-mcp.mjs"
      ],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${workspaceFolder}/credentials/credentials.json"
      }
    }
  }
}
