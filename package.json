{
  "name": "@6sense/sheet-e2e",
  "version": "0.1.43",
  "description": "Playwright + Unit Test runner UI, APIs, sheet sync, and CLI for Next.js apps",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasib6sense/sheet-e2e.git"
  },
  "bugs": {
    "url": "https://github.com/hasib6sense/sheet-e2e/issues"
  },
  "homepage": "https://github.com/hasib6sense/sheet-e2e#readme",
  "bin": {
    "sheet-e2e": "./bin/sheet-e2e.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "default": "./src/next/index.ts"
    },
    "./next/handlers": {
      "types": "./src/next/handlers.ts",
      "default": "./src/next/handlers.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "templates",
    "skills",
    "docs",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "googleapis": ">=140",
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.14",
    "googleapis": "^173.0.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5"
  }
}
